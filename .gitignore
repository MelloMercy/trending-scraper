# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Secrets / local env (never commit)
.env
.env.*
!.env.example
config.json
config.local.json
*secret*.json
*secrets*.json
*token*.json

# Project runtime data (DB, cookies, logs, browser/session state)
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Frontend (Vite / React)
webui/node_modules/
webui/dist/
webui/.vite/
webui/*.tsbuildinfo

# Build output (regenerated by `cd webui && npm run build`)
static/index.html
static/assets/

# GitHub Pages staging dir (assembled by the publish-pages workflow / local test)
/_site/

# Editorial/delivery drafts generated from cached data.
# Keep publish/README.md tracked as documentation.
publish/[0-9][0-9][0-9][0-9]-*/
publish/latest*

# Local browser/debug artifacts
playwright-report/
test-results/
*.trace.zip

# OS
.DS_Store
